# vitest@4 pulls vite@8 into the lockfile, and vite@8 requires Node >=20.19.
# vite is only used by tests — never at build or runtime — so skip yarn's engine
# check during install. This installs the exact locked versions; it does not
# change resolution. Lets the Railway build (Node 20.18) install cleanly.
--install.ignore-engines true
